{
  "name": "@riftfront/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared protocol, simulation, weapon data and validation for Project Riftfront",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@riftfront/config": "workspace:*",
    "typescript": "^5.7.3"
  }
}
