# Project Riftfront — environment configuration
#
# Copy to `.env` for local overrides, or set these in your deployment platform.
# Every value has a working default; nothing here is required to run `pnpm dev`.
#
# NOTE: there are no secrets in this project. Values prefixed with VITE_ are inlined
# into the browser bundle at build time and are public by definition — never put a
# credential behind a VITE_ prefix.

# ---------------------------------------------------------------------------
# Server (apps/server)
# ---------------------------------------------------------------------------

# TCP port the HTTP + WebSocket server binds to.
PORT=2567

# Interface to bind. 0.0.0.0 accepts connections from other devices on your LAN,
# which is what you want when testing from a phone or a second computer.
HOST=0.0.0.0

# Comma-separated list of allowed browser origins for CORS.
# '*' allows any origin — fine for local development, tighten for production, e.g.
#   RIFTFRONT_ALLOWED_ORIGINS=https://play.example.com
RIFTFRONT_ALLOWED_ORIGINS=*

# Exposes the Colyseus monitor dashboard at /colyseus. Leave off in production:
# it is unauthenticated and reveals room and connection internals.
RIFTFRONT_ENABLE_MONITOR=false

# Logs every rejected/invalid client message. Useful when tuning validation,
# noisy under normal packet loss.
RIFTFRONT_VERBOSE_VALIDATION=false

# ---------------------------------------------------------------------------
# Match rules (server-authoritative)
# ---------------------------------------------------------------------------

# Players required before the countdown starts.
# Set to 1 to play/test solo without a second browser.
RIFTFRONT_MIN_PLAYERS=2

# Hard room capacity.
RIFTFRONT_MAX_PLAYERS=8

# Countdown before a match begins, in milliseconds.
RIFTFRONT_COUNTDOWN_MS=5000

# Match length in milliseconds (default 5 minutes).
RIFTFRONT_MATCH_DURATION_MS=300000

# Eliminations that end the match early. Set to 0 to disable the score limit.
RIFTFRONT_SCORE_LIMIT=20

# Delay before an eliminated player respawns, in milliseconds.
RIFTFRONT_RESPAWN_DELAY_MS=3000

# How long the results screen stays up before the next match, in milliseconds.
RIFTFRONT_RESULTS_MS=10000

# ---------------------------------------------------------------------------
# Client (apps/client) — build-time only
# ---------------------------------------------------------------------------

# Origin of the game server.
# Leave unset for local development: the Vite dev server proxies /api and /matchmake
# to the game server, so the page's own origin works.
# For production, set this to the public origin of the server before building, e.g.
#   VITE_SERVER_URL=https://play.example.com
# VITE_SERVER_URL=

# Used only by `pnpm dev:client` to decide where to proxy. Defaults to
# http://localhost:2567 and does not affect production builds.
# VITE_SERVER_HTTP=http://localhost:2567
